# Sunucu
PORT=4001
NODE_ENV=development

# PostgreSQL — DATABASE_URL veya ayrı alanlar kullanılabilir
# Eski server.js (SQLite) varsayılan olarak 4000 portunu kullanır.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/pos_db

DB_HOST=localhost
DB_PORT=5432
DB_NAME=pos_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=12h
